cabal-version: 2.4
name: reaspeech
version: 0.3.0
synopsis: Haskell bindings and transcription CLI for ReaSpeech
license: MIT
build-type: Simple

library
  exposed-modules: ReaSpeech
  hs-source-dirs: src
  build-depends: base >=4.14 && <5, aeson >=2 && <3, bytestring, text
  extra-libraries: reaspeech
  default-language: Haskell2010
  ghc-options: -Wall

executable reaspeech-transcribe
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base >=4.14 && <5, aeson >=2 && <3, bytestring, text,
                 optparse-applicative >=0.16 && <0.20, reaspeech
  default-language: Haskell2010
  ghc-options: -Wall -threaded -rtsopts

test-suite bindings-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: base >=4.14 && <5, aeson >=2 && <3, bytestring, text, directory, reaspeech
  default-language: Haskell2010
  ghc-options: -Wall -threaded
